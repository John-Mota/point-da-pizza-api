# Banco de Dados PostgreSQL
DATASOURCE_HOST=localhost
DATASOURCE_PORT=5432
DATASOURCE_PG=point_da_pizza
DATASOURCE_USER=point_pizza
DATASOURCE_PASSWORD=troque_esta_senha
DATASOURCE_SSL_MODE=prefer

# HTTP / CORS (no Render, PORT e injetada automaticamente)
PORT=8080
API_PORT=8080
POSTGRES_EXTERNAL_PORT=5432
CORS_ORIGINS=/.*/

# JWT (minimo 32 caracteres em producao)
JWT_SECRET=troque-por-um-segredo-forte-com-pelo-menos-32-caracteres

# Cloudinary (upload de fotos de usuarios e produtos)
CLOUD_NAME=seu_cloud_name
CLOUD_API_KEY=sua_api_key
CLOUD_API_SECRET=seu_api_secret
